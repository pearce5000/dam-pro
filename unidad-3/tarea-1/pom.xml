<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>es.educacion</groupId>
  <artifactId>java-arrays-ejercicios</artifactId>
  <version>1.0.0</version>
  <name>20 ejercicios guiados de arrays en Java</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.test.failure.ignore>false</maven.test.failure.ignore>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <testFailureIgnore>${maven.test.failure.ignore}</testFailureIgnore>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>nota</id>
      <properties>
        <!-- Se ejecutan las 100 pruebas incluso si fallan para emitir la nota -->
        <maven.test.failure.ignore>true</maven.test.failure.ignore>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>evaluar-estilo</id>
                <phase>verify</phase>
                <goals><goal>checkstyle</goal></goals>
              </execution>
            </executions>
            <configuration>
              <configLocation>checkstyle.xml</configLocation>
              <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
              <outputFileFormat>xml</outputFileFormat>
              <includeTestSourceDirectory>false</includeTestSourceDirectory>
              <failsOnError>false</failsOnError>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <version>3.26.0</version>
            <configuration>
              <targetJdk>21</targetJdk>
              <includeTests>false</includeTests>
              <format>xml</format>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <minimumTokens>35</minimumTokens>
              <failOnViolation>false</failOnViolation>
            </configuration>
            <executions>
              <execution>
                <id>evaluar-pmd-y-duplicados</id>
                <phase>verify</phase>
                <goals><goal>pmd</goal><goal>cpd</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
              <reportOutputDirectory>${project.build.directory}/reports</reportOutputDirectory>
            </configuration>
            <executions>
              <execution>
                <id>generar-api</id>
                <phase>verify</phase>
                <goals><goal>javadoc</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>calcular-nota</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>python3</executable>
                  <arguments><argument>${project.basedir}/calcular_nota.py</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
